<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RF1: the NORMALISED, game-free behaviour test executable.

    Why it exists. Before this, offline C# assertions lived in two ad-hoc probes
    (recon_probe/Program.cs and test/TierTest/Program.cs): no case names, no groups, no
    negative control, and nothing covered the battle clock, the 0.35 s hit-pairing window,
    ResetActors, the per-second series or the contribution cache. Those are exactly the
    places a refactor can change behaviour without changing any number a battle produces.

    It executes the REAL production sources below (never a copy of the formula). Everything
    else comes from Stubs.cs, which declares ONLY the members those files touch, so a
    compiled file that starts depending on the game surface fails the build here instead of
    silently drifting.

    SrcRoot is parameterised (default ..\..\src) so the negative-control driver can build the
    SAME test against a TAMPERED COPY of the sources and require the matching case to go red.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>BehaviorTests</AssemblyName>
    <RootNamespace>BehaviorTests</RootNamespace>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <SrcRoot Condition="'$(SrcRoot)' == ''">..\..\src</SrcRoot>
  </PropertyGroup>
  <ItemGroup>
    <!-- pure: no Unity, no IL2CPP, no Plugin, no Aggregator -->
    <Compile Include="$(SrcRoot)\BuildInfo.cs" />
    <Compile Include="$(SrcRoot)\Model\BattleTime.cs" />
    <Compile Include="$(SrcRoot)\Model\BattleEvent.cs" />
    <Compile Include="$(SrcRoot)\Model\ActorStats.cs" />
    <Compile Include="$(SrcRoot)\Model\BattleSummary.cs" />
    <!-- R56: the battle identity (pure: no Unity, no file system). -->
    <Compile Include="$(SrcRoot)\Model\BattleRef.cs" />
    <Compile Include="$(SrcRoot)\Model\CalcBreakdown.cs" />
    <Compile Include="$(SrcRoot)\Model\FoldStep.cs" />
    <Compile Include="$(SrcRoot)\Model\StatusKey.cs" />
    <Compile Include="$(SrcRoot)\Model\ClauseStatusRun.cs" />
    <Compile Include="$(SrcRoot)\Model\AtkAddFold.cs" />
    <!-- R87 (方案A): the self-addend census. Pure on purpose: the two mapping tables (talent type to
         the name the runtime prints, reference code to the name inside the Ref string) cannot be read
         off the code at all; they were MEASURED against abilities whose printed name states the same
         thing, so a reader has to be able to hold them to the corpus. The key builders and the
         team-scoped declarer match are the parts a wrong edit would break, and they are exactly the
         parts this makes executable. The JSON writer rides along because R80 shipped a section whose
         writer produced unquoted strings and no compiled test could see the bytes. -->
    <Compile Include="$(SrcRoot)\Model\AtkAddCensus.cs" />
    <Compile Include="$(SrcRoot)\Policy\AtkAddDeclarePolicy.cs" />
    <Compile Include="$(SrcRoot)\Policy\AtkAddCensusPolicy.cs" />
    <Compile Include="$(SrcRoot)\Output\Contribution.cs" />
    <Compile Include="$(SrcRoot)\Output\CalcReconcile.cs" />
    <Compile Include="$(SrcRoot)\Output\JsonText.cs" />
    <Compile Include="$(SrcRoot)\Output\JsonCheck.cs" />
    <Compile Include="$(SrcRoot)\Composition\TieredModifier.cs" />
    <!-- RF3: the pure policy layer. These files must stay game-free, and compiling them here is what
         enforces it: the build fails the moment one of them touches Unity/IL2CPP/Plugin. -->
    <Compile Include="$(SrcRoot)\Policy\BattleClockPolicy.cs" />
    <Compile Include="$(SrcRoot)\Policy\SessionTransitionPolicy.cs" />
    <Compile Include="$(SrcRoot)\Policy\AttributionPolicy.cs" />
    <Compile Include="$(SrcRoot)\Policy\GlobalRuleClassifier.cs" />
    <Compile Include="$(SrcRoot)\Policy\ContributionCachePolicy.cs" />
    <Compile Include="$(SrcRoot)\Policy\MasterDataLabelPolicy.cs" />
    <Compile Include="$(SrcRoot)\Policy\CompositionTolerancePolicy.cs" />
    <Compile Include="$(SrcRoot)\Policy\GlobalRuleApplyPolicy.cs" />
    <!-- R63's `SkillCooldownPolicy` was DELETED in R65: its only caller published the auto-skill
         cooldown x30, and a live battle falsified the "the master stores seconds" premise (the live
         `Skill.CoolTimeFrame` equals the master value verbatim on 9 of 9 auto skills). The knowledge that
         replaced it is a DIVISION, and it lives in `AutoSkillCadencePolicy.SecondsFor` just below. -->
    <!-- R64: the auto-skill cadence arithmetic (charge units/second, the charge expressed in seconds, the
         interval between activations, its median). Pure by construction: the readings themselves need the
         IL2CPP surface and live in the probe, the conversions that publish them do not. -->
    <Compile Include="$(SrcRoot)\Policy\AutoSkillCadencePolicy.cs" />
    <!-- R66: the 技能时间表: one row per (unit, skill) out of a raw activation stream. Pure: the
         readings need the IL2CPP surface (Diagnostics/SkillTimelineProbe.cs), the arithmetic that
         publishes them does not, and that arithmetic is where a wrong table would hide (a merge window
         that eats a real activation, a median taken over the wrong gaps, rows that reorder mid-battle). -->
    <Compile Include="$(SrcRoot)\Model\SkillTimelineEvent.cs" />
    <!-- R69: the attempt tally (a count, not a stamped event: an attempt has no moment and must never
         enter the fold or a median) and the verdict that decides activation vs attempt. Both pure. -->
    <Compile Include="$(SrcRoot)\Model\SkillTimelineAttempt.cs" />
    <Compile Include="$(SrcRoot)\Policy\SkillActivationPolicy.cs" />
    <!-- R70: whose side an observation belongs to (team 1 = ours). Moved out of `CharacterInfo.IsAlly` so the
         three skill routes and the contribution surfaces share one verdict, and so it can be mutated. -->
    <Compile Include="$(SrcRoot)\Policy\SkillSidePolicy.cs" />
    <!-- R71: the battle clock's ORIGIN calibration (lag from the auto-skill counters, its bounds, the median
         and the one-origin-per-battle rule). Pure: the facade reads the live counters and adds the result. -->
    <Compile Include="$(SrcRoot)\Policy\BattleClockCalibrationPolicy.cs" />
    <!-- R74: what the calibration sampler saw, one bucket per value. Pure (no Unity/IL2CPP/Plugin), so the
         counters and the exact `[CLOCK] calib` text are executed rather than eyeballed, which is the whole
         point of a line that exists to be read. -->
    <Compile Include="$(SrcRoot)\Policy\ClockLagDiagnostics.cs" />
    <!-- R75: which mechanism withheld part of a damage-application call. Pure: the READINGS need the IL2CPP
         surface (Diagnostics/AbsorbProbe.cs), the decision that turns them into a verdict does not, and that
         decision is exactly where an invented carrier would hide. `CarrierUnknown` and `Unreadable` are
         answers the suite has to be able to hold the classifier to. -->
    <Compile Include="$(SrcRoot)\Policy\AbsorbClassifyPolicy.cs" />
    <!-- R78: the WORDS. Everything the plugin says about an oversized call is produced here, so the exact
         text of the three fields and of the `[ABSPROBE] note` line is executed rather than eyeballed. Pure
         (no IL2CPP): it takes the numbers and the verdict and returns the string, which is the only way the
         suite can hold a sentence to the arithmetic it claims. -->
    <Compile Include="$(SrcRoot)\Policy\AbsorbWording.cs" />
    <!-- R79: 受击来源拆分. The three DamageSource / eDamageCalcType label maps moved out of
         CompositionProbe.Text.cs (that file touches BattleObject/GameRef and cannot be compiled here), and
         the projection itself is pure, so the bucket invariants and every printed row are executed rather
         than eyeballed. The cache policy only delegates to ContributionCachePolicy's rule. -->
    <Compile Include="$(SrcRoot)\Policy\DamageSourceLabelPolicy.cs" />
    <Compile Include="$(SrcRoot)\Model\TakenBreakdown.cs" />
    <Compile Include="$(SrcRoot)\Policy\TakenBreakdownPolicy.cs" />
    <Compile Include="$(SrcRoot)\Policy\TakenCachePolicy.cs" />
    <!-- R72: the rule that makes the shift LAND: an event arriving before the origin is decided is held and
         replayed at its arrival + the lag, instead of being published on the old axis and blocking the
         shift (which is what happened in every battle the user played). Pure arithmetic + the queue type. -->
    <Compile Include="$(SrcRoot)\Policy\ClockOriginHoldPolicy.cs" />
    <Compile Include="$(SrcRoot)\Runtime\OriginHeldEvent.cs" />
    <Compile Include="$(SrcRoot)\Policy\SkillTimelinePolicy.cs" />
    <!-- R52: the extraction-flow decisions (trigger key, bundle name, retention). Game-free by
         construction, which is what lets the retention rule be executed instead of argued about. -->
    <Compile Include="$(SrcRoot)\Policy\ExtractPolicy.cs" />
    <!-- R56 (BID-0): the frozen battle-reference contract (format, lifecycle, file name, copy text). -->
    <Compile Include="$(SrcRoot)\Policy\BattleRefPolicy.cs" />
    <!-- RF4: the first state family. Game-free by construction (BattleSession only), which is what makes
         the Start/End/resume sequences executable here instead of only in a battle. -->
    <Compile Include="$(SrcRoot)\Runtime\SessionContinuity.cs" />
    <Compile Include="$(SrcRoot)\Runtime\GlobalRuleRegistry.cs" />
    <Compile Include="$(SrcRoot)\Runtime\BattleRuntimeCounters.cs" />
    <Compile Include="$(SrcRoot)\Runtime\CalcActivityLog.cs" />
    <Compile Include="$(SrcRoot)\Runtime\AttackSnapshot.cs" />
    <Compile Include="$(SrcRoot)\Runtime\BattleHistoryRing.cs" />
    <!-- R56 (BID-1): the launch namespace + session sequence allocator (time/random injected). -->
    <Compile Include="$(SrcRoot)\Runtime\BattleRefRegistry.cs" />
    <!-- RF5b: the overlay text layout. No Unity type is involved, which is why it can be compiled here
         and executed as production code instead of being mirrored by a Python replica. -->
    <Compile Include="$(SrcRoot)\Ui\DisplayFormat.cs" />
    <!-- R66: the 技能时间表's page text (same reason as the contribution columns: the geometry and the
         xN / +N markers are numbers a reader must be able to check, and the battle-end [SKILLTL] lines
         print these very strings). -->
    <Compile Include="$(SrcRoot)\Ui\SkillTimelineText.cs" />
    <Compile Include="$(SrcRoot)\Ui\ContributionColumns.cs" />
    <Compile Include="$(SrcRoot)\Ui\FallbackText.cs" />
    <Compile Include="$(SrcRoot)\Ui\ContributionRowModel.cs" />
    <!-- R79: the 受击来源拆分 page (F3). Same reason: the column widths, the fold marker and the 口径 words
         are what a reader checks, and these are the very strings the panel draws. -->
    <Compile Include="$(SrcRoot)\Ui\TakenColumns.cs" />
    <Compile Include="$(SrcRoot)\Ui\TakenPageText.cs" />
    <!-- R82: the hotkey bars of the F3/F5/F6/F4 pages and the roster. Pure on purpose: the bars' text is
         exactly what used to be printed, and the tests pin that (the click dispatch in the overlay maps
         each entry to the same method the key calls, so the enum is named after keys). -->
    <Compile Include="$(SrcRoot)\Ui\HotkeyBarText.cs" />
    <!-- R85: the F6 detail page's PERSPECTIVE (输出明细 / 承伤明细). Pure: the two predicates and the three
         words are exactly what a reader checks, and the key/matcher agreement between the F7 list and the
         F7 matcher is an invariant that a comment cannot hold. A list offering an entry the matcher never
         accepts is the bug class this extraction exists to make impossible. -->
    <Compile Include="$(SrcRoot)\Ui\DetailPerspective.cs" />
    <Compile Include="$(SrcRoot)\Diagnostics\ParamOwnerProbe.cs" />
    <!-- impure, but the game surface it touches is small and stubbed:
         HitRecord -> BattleObject/DamageSource/eDamageCalcType
         BattleSession -> GameRef/CharacterInfo/BattleObject/TeamType/GameResult
         ContributionSession -> UnityEngine.Time + Aggregator.Session
         TakenSession -> the same, plus Aggregator.History (R80: the page outlives the battle).
         R80 added the last one BECAUSE it was missing: its JSON writer shipped in R79 with unquoted
         string values, and no compiled test could see the bytes it produced. -->
    <Compile Include="$(SrcRoot)\Model\HitRecord.cs" />
    <Compile Include="$(SrcRoot)\Model\BattleSession.cs" />
    <Compile Include="$(SrcRoot)\Output\ContributionSession.cs" />
    <Compile Include="$(SrcRoot)\Output\TakenSession.cs" />
  </ItemGroup>
</Project>
