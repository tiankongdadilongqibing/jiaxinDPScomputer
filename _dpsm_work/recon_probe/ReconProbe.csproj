<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Offline, game-free executable test for the 1.3.0 reconciliation module.

    It compiles the REAL source files (Model/CalcBreakdown.cs, Output/CalcReconcile.cs) plus a minimal
    stub for BattleSession/BattleEvent, so the classification and the JSON emission are executed and
    checked rather than eyeballed. No game assembly is referenced: CalcReconcile only touches the event
    stream and StringBuilder, so this runs anywhere the .NET 6 SDK does.

    Precedent: _dpsm_work/routeA_probe (which disproved 6 assumptions at compile level before 1.1.0).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ReconProbe</AssemblyName>
    <RootNamespace>ReconProbe</RootNamespace>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\src\Model\CalcBreakdown.cs" />
    <Compile Include="..\src\Model\FoldStep.cs" />
    <!-- 1.5.2: the FACT signature's status-set canonicalisation. Split out of Diagnostics/FactStore.cs
         (which needs IL2CPP) precisely so this project can EXECUTE it: the ordering rule is now pinned
         by a test instead of promised by a comment. -->
    <Compile Include="..\src\Model\StatusKey.cs" />
    <!-- 1.5.3: the clause -> status-name run matching, split out of CompositionProbe.Status/Rules.cs
         (which need IL2CPP). Same reason as StatusKey: the と/や joiner cost 1.15^2 per hit on two
         real rules and was invisible until the per-hit data was inspected, so it is pinned by an
         executable test from now on. -->
    <Compile Include="..\src\Model\ClauseStatusRun.cs" />
    <Compile Include="..\src\Output\CalcReconcile.cs" />
    <Compile Include="..\src\Output\JsonCheck.cs" />
    <Compile Include="..\src\Output\JsonText.cs" />
    <Compile Include="..\src\Output\Contribution.cs" />
    <!-- 1.7.2 (阶段 G): the applied-parameter OWNER channel. Compiled (not referenced) for the same
         reason as the others: its counters and its JSON shape are asserted by execution. -->
    <Compile Include="..\src\Diagnostics\ParamOwnerProbe.cs" />
    <!-- 1.7.4 (阶段 G): the attack-power attribution formula. Pure by construction, so the factor, the
         collision rule and every refusal guard are EXECUTED here rather than eyeballed. -->
    <Compile Include="..\src\Model\AtkAddFold.cs" />
  </ItemGroup>
</Project>
